---
import CodeBlock from '../shared/CodeBlock.astro';
import { CDN_BASE, CDN_JS, CDN_CLASSLESS } from '../../lib/meta';

const base = import.meta.env.BASE_URL;
const qsFullLink = `
<link rel="stylesheet" href="${CDN_BASE}style.min.css">
`;
const qsFullTheme = `
<html lang="en" data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsFullPage = `
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="${CDN_BASE}style.min.css">
</head>
<body>
  <button class="btn btn-primary">Hello njX</button>
  <div class="card-glow">
    <h2 class="text-gradient-primary">Works.</h2>
  </div>
</body>
</html>
`;
const qsFullJs = `
<!-- Adds: collapseToggle, tabSwitch, dropdownToggle,
     openModal, closeModal, showToast, initCarousels -->
<script src="${CDN_JS}"></script>
`;
const qsClasslessLink = `
<link rel="stylesheet" href="${CDN_CLASSLESS}">
`;
const qsClasslessPage = `
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="${CDN_CLASSLESS}">
</head>
<body>
  <button>Hello njX</button>
  <article>
    <h2>Works.</h2>
    <p>No class names needed.</p>
  </article>
</body>
</html>
`;
const qsClasslessTheme = `
<html data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsInteractiveLink = `
<!-- In <head> -->
<link rel="stylesheet" href="${CDN_BASE}style.min.css">

<!-- Before </body> -->
<script src="${CDN_JS}"></script>
`;
const qsInteractiveTheme = `
<html lang="en" data-theme="dark">
<!-- dark · light · red · blue · green · cyan · yellow · pink · purple -->
`;
const qsInteractivePage = `
<button class="btn btn-primary" onclick="openModal('demo')">Open Modal</button>
<button class="btn btn-accent" onclick="showToast('Done!','success')">Toast</button>

<div class="modal" id="demo">
  <div class="modal-box">
    <h3>Hello from njX JS</h3>
    <button onclick="closeModal('demo')">Close</button>
  </div>
</div>
`;
---

<section class="doc-section" id="quickstart">
                <!-- ── Flavor-aware section header ── -->
                <div
                    class="doc-section-header"
                >
                    <span class="sc-eyebrow">Getting started</span>
                    <h1 class="sc-heading">Quick Start</h1>
                    <p class="sc-subheading">
                        One file, zero class names. Semantic HTML is styled
                        automatically via element selectors — connect <code
                            style="color:var(--color-primary)"
                            >classless.min.css</code
                        > and write plain HTML. Need component classes instead?
                        The full library lives at <a
                            href="https://njxui.dev"
                            style="color:var(--color-primary)">njxui.dev</a
                        >.
                    </p>
                </div>

                <!-- ── One-build tip ── -->
                <div class="doc-mix-tip">
                    <span class="doc-mix-tip-icon">✦</span>
                    <span>
                        <strong>One stylesheet at a time.</strong>
                        <code>classless.min.css</code> and the full
                        <code>style.min.css</code> are standalone builds —
                        don't load both together.
                    </span>
                </div>

                <div
                    class="doc-steps"
                >
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">1</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Add the stylesheet</div>
                            <div class="doc-step-desc">
                                One <code>&lt;link&gt;</code> tag in <code
                                    >&lt;head&gt;</code
                                >. No configuration needed.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsClasslessLink} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">2</div>
                            <div class="doc-step-line"></div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">Write plain HTML</div>
                            <div class="doc-step-desc">
                                No class names needed. Every native HTML element
                                — <code>&lt;button&gt;</code>, <code
                                    >&lt;table&gt;</code
                                >, <code>&lt;form&gt;</code>, <code
                                    >&lt;details&gt;</code
                                > — gets styled automatically.
                            </div>
                            <CodeBlock frame="sc" lang="html" label="index.html" code={qsClasslessPage} />
                        </div>
                    </div>
                    <div class="doc-step">
                        <div class="doc-step-left">
                            <div class="doc-step-num">3</div>
                        </div>
                        <div class="doc-step-body">
                            <div class="doc-step-title">
                                Themes <span
                                    style="font-size:12px;font-weight:400;color:var(--color-muted)"
                                    >(optional)</span
                                >
                            </div>
                            <div class="doc-step-desc">
                                Classless supports the same 9 themes. Add <code
                                    >data-theme</code
                                > to <code>&lt;html&gt;</code> to switch color palettes.
                            </div>
                            <CodeBlock frame="sc" lang="html" code={qsClasslessTheme} />
                        </div>
                    </div>
                </div>

                <!-- ── Steps: Interactive ── -->

                <div class="doc-tip" style="margin-top:28px">
                    <span class="doc-tip-icon">📦</span>
                    <div class="doc-tip-text">
                        <strong>More install options:</strong> npm install, download
                        ZIP, or import individual CSS files. See the <a
                            href={`${base}quickstart`}
                            style="color:var(--color-primary)"
                            >Quick Start guide</a
                        > for all methods.
                    </div>
                </div>
            </section>
