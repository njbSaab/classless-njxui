---
import Demo from '../shared/Demo.astro';

const fullTableWithTheadTbodyTfootCode = `
<table>
  <caption>Team Members</caption>
  <thead>
    <tr><th>Name</th><th>Role</th><th>Status</th></tr>
  </thead>
  <tbody>
    <tr><td>Alice Chen</td><td>Developer</td><td>Active</td></tr>
    <tr><td>Bob Kline</td><td>Designer</td><td>Active</td></tr>
  </tbody>
  <tfoot>
    <tr><td colspan="2">Total</td><td>2</td></tr>
  </tfoot>
</table>
`;
---

<section class="lib-section cl-section" id="tables">
    <div class="lib-section-title">📊 Tables</div>
    <div class="lib-section-desc">
        Native <code>&lt;table&gt;</code> with <code>thead</code>, <code>tbody</code>, <code>tfoot</code> and <code>caption</code> — all styled by <code>_native.css</code>.
    </div>

    <Demo is:raw label={'Full table with thead / tbody / tfoot'} code={fullTableWithTheadTbodyTfootCode}>
            <article>
                <table>
                    <caption>Team Members</caption>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Role</th>
                            <th>Location</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Alice Chen</td>
                            <td>Lead Developer</td>
                            <td>San Francisco</td>
                            <td>Active</td>
                        </tr>
                        <tr>
                            <td>Bob Kline</td>
                            <td>Designer</td>
                            <td>Berlin</td>
                            <td>Active</td>
                        </tr>
                        <tr>
                            <td>Carol Davis</td>
                            <td>DevOps</td>
                            <td>London</td>
                            <td>Away</td>
                        </tr>
                        <tr>
                            <td>Dan Park</td>
                            <td>QA Engineer</td>
                            <td>Seoul</td>
                            <td>Active</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3">Total members</td>
                            <td>4</td>
                        </tr>
                    </tfoot>
                </table>
            </article>
        </Demo>
</section>
