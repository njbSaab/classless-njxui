---
import Demo from '../shared/Demo.astro';

const unorderedListCode = `
<ul>
  <li>First item</li>
  <li>Second item</li>
  <li>Third item
    <ul>
      <li>Nested item</li>
    </ul>
  </li>
</ul>
`;

const orderedListCode = `
<ol>
  <li>Design the layout</li>
  <li>Write semantic HTML</li>
  <li>Apply classless CSS
    <ol>
      <li>Link the stylesheet</li>
      <li>Set data-theme</li>
    </ol>
  </li>
  <li>Ship it</li>
</ol>
`;
---

<section class="lib-section cl-section" id="lists">
    <div class="lib-section-title">≡ Lists</div>
    <div class="lib-section-desc">
        Unordered, ordered, and nested lists styled by <code>_native.css</code>.
    </div>

    <Demo is:raw label={'Unordered list'} code={unorderedListCode}>
            <article>
                <ul>
                    <li>First item</li>
                    <li>Second item with <a href="#">a link</a></li>
                    <li>Third item
                        <ul>
                            <li>Nested item one</li>
                            <li>Nested item two</li>
                        </ul>
                    </li>
                    <li>Fourth item</li>
                </ul>
            </article>
        </Demo>

    <Demo is:raw label={'Ordered list'} code={orderedListCode}>
            <article>
                <ol>
                    <li>Design the layout</li>
                    <li>Write semantic HTML</li>
                    <li>Apply classless CSS
                        <ol>
                            <li>Link the stylesheet</li>
                            <li>Set data-theme</li>
                        </ol>
                    </li>
                    <li>Ship it</li>
                </ol>
            </article>
        </Demo>
</section>
