---
import Demo from '../shared/Demo.astro';

const ariaBusyOnArticleCode = `
<article aria-busy="true">
  <h3>Project analytics</h3>
  <p>Loading content…</p>
  <button>View report</button>
</article>
`;

const ariaBusyOnSectionCode = `
<section aria-busy="true">
  <p>Section loading…</p>
</section>
`;

const buttonLoadingStateCode = `
<button aria-busy="true">Saving…</button>
<button aria-busy="true" data-variant="accent">Submitting…</button>
`;

const inlineSpinnerDataLoadingCode = `
<p><span data-loading></span> Fetching data…</p>
`;
---

<section class="lib-section cl-section" id="loading">
    <div class="lib-section-title">⏳ Loading</div>
    <div class="lib-section-desc">
        <code>aria-busy="true"</code> on any block element adds a frosted overlay
        + spinning indicator from <code>_native.css</code>. Use <code
            >[role="status"]</code
        > for an inline spinner. No extra markup needed.
    </div>

    <Demo is:raw label={'aria-busy on article'} code={ariaBusyOnArticleCode}>
            <article class="cl-loading-demo">
                <article aria-busy="true" aria-label="Loading project card">
                    <h3>Project analytics</h3>
                    <p>Loading content…</p>
                    <div class="cl-loading-lines" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <p>
                        <button data-variant="primary">View report</button>
                        <button>Export</button>
                    </p>
                </article>
            </article>
        </Demo>

    <Demo is:raw label={'aria-busy on section'} code={ariaBusyOnSectionCode}>
            <article class="cl-loading-demo">
                <section
                    aria-busy="true"
                    aria-label="Loading settings section"
                >
                    <h3>Account settings</h3>
                    <p>Section loading…</p>
                    <progress value="68" max="100"></progress>
                </section>
            </article>
        </Demo>

    <Demo is:raw label={'Button loading state'} code={buttonLoadingStateCode}>
            <article>
                <button aria-busy="true">Saving…</button>
                <button aria-busy="true" data-variant="accent"
                    >Submitting…</button
                >
                <button aria-busy="true" data-variant="success">Done</button>
            </article>
        </Demo>

    <Demo is:raw label={'Inline spinner — <code>data-loading</code>'} code={inlineSpinnerDataLoadingCode}>
            <article>
                <p><span data-loading></span> Fetching data…</p>
                <p style="display:flex;align-items:center;gap:.5rem;">
                    <span data-loading></span>
                    <span>Syncing changes</span>
                </p>
            </article>
        </Demo>
</section>

<style is:global>
    .cl-loading-demo {
        display: block !important;
        width: 100%;
    }

    .cl-loading-demo > article,
    .cl-loading-demo > section {
        min-height: 180px;
        padding: 24px !important;
        border: 1px solid color-mix(in srgb, var(--color-primary) 24%, transparent) !important;
        border-radius: 18px !important;
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--color-primary) 8%, transparent), transparent 46%),
            color-mix(in srgb, var(--color-dark-secondary) 88%, transparent) !important;
        box-shadow: 0 16px 36px color-mix(in srgb, #000 16%, transparent);
    }

    .cl-loading-demo h3,
    .cl-loading-demo p {
        margin-bottom: 12px !important;
    }

    .cl-loading-demo button {
        min-height: 38px;
        padding: 0 14px;
        border: 1px solid color-mix(in srgb, var(--color-primary) 34%, transparent);
        border-radius: 10px;
        background: color-mix(in srgb, var(--color-primary) 10%, transparent);
        color: var(--color-primary);
        font: inherit;
        font-size: 13px;
        font-weight: 800;
    }

    .cl-loading-demo button[data-variant='primary'] {
        border-color: var(--color-primary);
        background: var(--color-primary);
        color: var(--сolor-dark);
    }

    .cl-loading-lines {
        display: grid;
        gap: 10px;
        margin: 18px 0;
    }

    .cl-loading-lines span {
        display: block;
        height: 10px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--color-primary) 16%, transparent);
    }

    .cl-loading-lines span:nth-child(2) {
        width: 72%;
    }

    .cl-loading-lines span:nth-child(3) {
        width: 46%;
    }
</style>
