---
import { LIB_VERSION } from '../../lib/meta';

const base = import.meta.env.BASE_URL;
---

  <!-- ══════════════════════ HERO ══════════════════════ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <!-- Left: copy + CTAs + stats -->
        <div class="hero-left">
          <div class="label">
            <span class="pulse"></span>
            Open Source · MIT License · v{LIB_VERSION}
          </div>
          <h1>
            <span class="grad">Plain HTML.</span><br />
            Nine&nbsp;themes.<br />
            <span class="dim">Zero&nbsp;classes.</span>
          </h1>
          <p class="sub">
            A classless stylesheet — ~7&nbsp;KB gzipped over the wire — that
            styles semantic HTML as-is and flips themes with one attribute.
            Change the theme and watch the page re-tint instantly.
          </p>
          <div class="hero-cta">
            <a href={`${base}quickstart`} class="btn-pill primary"
              >↓ Get Started</a
            >
            <a href={`${base}`} class="btn-pill ghost">Try it live</a>
          </div>
          <div class="stats-inline">
            <div>
              <div class="v">~7 KB</div><div class="l">Gzip bundle</div>
            </div>
            <div><div class="v">9</div><div class="l">Themes</div></div>
            <div><div class="v">20+</div><div class="l">Elements</div></div>
            <div><div class="v">0</div><div class="l">Classes</div></div>
          </div>
        </div>

        <!-- Right: Interactive Playground -->
        <div class="playground">
          <div class="pg-bar">
            <span class="dot" style="background:#ff5f57"></span>
            <span class="dot" style="background:#febc2e"></span>
            <span class="dot" style="background:#28c840"></span>
            <div class="url">
              &lt;html <span style="color:var(--color-primary)" id="ov-attr"
                >data-theme="dark"</span
              >&gt;
            </div>
          </div>
          <div class="pg-controls">
            <div class="seg" id="ov-modeseg">
              <button class="on" data-m="auth">Auth</button>
              <button data-m="dash">Dashboard</button>
              <button data-m="form">Form</button>
            </div>
            <div class="pg-tswatches" id="ov-tswatches"></div>
          </div>
          <div class="pg-body" id="ov-pgbody"></div>
        </div>
      </div>
    </div>
  </section>

